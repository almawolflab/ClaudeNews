{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almawolflab.github.io/ClaudeNews/templates/editions.schema.json",
  "title": "data/editions.json",
  "description": "Textos del sitio y lista de ediciones. Un ítem pertenece a la edición cuyo rango desde–hasta contiene su fecha.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sitio", "ediciones"],
  "properties": {
    "$schema": { "type": "string" },
    "sitio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "marca", "secciones", "recursos", "contacto", "pie"],
      "properties": {
        "nombre": { "type": "string" },
        "marca": { "type": "string" },
        "repo": { "type": "string", "format": "uri" },
        "secciones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["novedades", "impacto", "cronologia", "recursos"],
          "properties": {
            "novedades": { "$ref": "#/$defs/seccion" },
            "impacto": { "$ref": "#/$defs/seccion" },
            "cronologia": { "$ref": "#/$defs/seccion" },
            "recursos": { "$ref": "#/$defs/seccion" }
          }
        },
        "recursos": {
          "description": "Tarjetas de 'Primeros pasos'. Solo se muestran las que tienen url.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "titulo", "texto", "url", "cta", "icono"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "titulo": { "type": "string" },
              "texto": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"], "format": "uri" },
              "cta": { "type": "string" },
              "icono": { "type": "string", "enum": ["doc", "formacion", "chat"] }
            }
          }
        },
        "contacto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titulo", "texto", "cta"],
          "properties": {
            "titulo": { "type": "string" },
            "texto": { "type": "string" },
            "cta": { "description": "Texto del botón; abre el modo comentarios.", "type": "string" }
          }
        },
        "pie": { "type": "string" }
      }
    },
    "ediciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "numero", "periodo", "desde", "hasta", "publicado", "responsable", "proxima", "hero"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "numero": { "type": "integer", "minimum": 1 },
          "periodo": { "type": "string" },
          "desde": { "type": "string", "format": "date" },
          "hasta": { "description": "Inclusive. null = edición abierta.", "type": ["string", "null"], "format": "date" },
          "publicado": { "type": "string", "format": "date" },
          "responsable": { "type": ["string", "null"] },
          "proxima": { "description": "Fecha prevista de la próxima edición.", "type": ["string", "null"], "format": "date" },
          "hero": {
            "type": "object",
            "additionalProperties": false,
            "required": ["antetitulo", "titulo", "tituloDestacado", "intro"],
            "properties": {
              "antetitulo": { "type": "string" },
              "titulo": { "type": "string" },
              "tituloDestacado": { "type": "string" },
              "intro": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "seccion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etiqueta", "titulo"],
      "properties": {
        "etiqueta": { "type": "string" },
        "titulo": { "type": "string" },
        "intro": { "type": "string" }
      }
    }
  }
}
