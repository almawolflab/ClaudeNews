{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almawolflab.github.io/ClaudeNews/templates/item.schema.json",
  "title": "Ítem de ClaudeNews",
  "description": "Un contenido publicado (o propuesto) en ClaudeNews. Los campos comunes valen para todos los tipos; cada tipo añade los suyos (ver allOf).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "empresas", "titulo", "resumen", "fecha", "fuente", "estado"],
  "properties": {
    "id": {
      "description": "AAAA-MM-DD-slug. Único en items.json y drafts/.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tipo": { "type": "string", "enum": ["novedad", "video", "docs", "caso", "repo"] },
    "empresas": {
      "description": "Audiencias a las que interesa. 'transversal' = todo el grupo.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["sagitaz", "woztell", "finanzas", "transversal"] }
    },
    "titulo": { "type": "string", "minLength": 3, "maxLength": 140 },
    "resumen": { "type": "string", "minLength": 3, "maxLength": 400 },
    "fecha": { "description": "Fecha de la novedad (AAAA-MM-DD). Decide la edición.", "type": "string", "format": "date" },
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "nombre", "oficial"],
      "properties": {
        "url": { "description": "null solo mientras falte la URL real; nunca inventarla.", "type": ["string", "null"], "format": "uri" },
        "nombre": { "type": "string", "minLength": 1 },
        "oficial": { "description": "true si la fuente es Anthropic o el fabricante de la herramienta.", "type": "boolean" }
      }
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "featured": { "description": "Candidata a novedad destacada de la edición.", "type": "boolean" },
    "puntos": {
      "description": "Opcional. 'Qué cambia para nosotros' en la destacada (máx. 3).",
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
    "estado": { "type": "string", "enum": ["borrador", "aprobado", "rechazado", "archivado"] },
    "validacion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "juez": { "type": "string" },
        "fecha": { "type": "string", "format": "date" },
        "notas": { "description": "Por qué encaja con la audiencia asignada / motivo de rechazo.", "type": "string" }
      }
    },

    "youtubeId": { "description": "Solo video. null mientras falte.", "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{11}$" },

    "repoUrl": { "description": "Solo repo. null mientras falte.", "type": ["string", "null"], "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "licencia": { "description": "Solo repo (SPDX, p. ej. MIT).", "type": ["string", "null"] },

    "formato": { "description": "Solo docs.", "type": "string", "enum": ["guia", "enlace", "pdf"] },

    "empresa": { "description": "Solo caso: área o equipo que lo aplicaría.", "type": "string", "enum": ["sagitaz", "woztell", "finanzas", "transversal"] },
    "novedadBase": { "description": "Solo caso: novedad en la que se basa.", "type": "string", "minLength": 3 },
    "porQueEncaja": { "description": "Solo caso: dato del grupo que lo justifica.", "type": "string", "minLength": 3 },
    "primerPaso": { "description": "Solo caso: prueba pequeña para validarlo.", "type": "string", "minLength": 3 },
    "esfuerzo": { "description": "Solo caso.", "type": "string", "enum": ["bajo", "medio", "alto"] },
    "impacto": { "description": "Solo caso: ahorro de tiempo, calidad, nuevo servicio…", "type": "string", "minLength": 3 },
    "resultado": { "description": "Solo caso: resultado obtenido, si ya se probó.", "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "video" } } },
      "then": { "required": ["youtubeId"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "repo" } } },
      "then": { "required": ["repoUrl"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "docs" } } },
      "then": { "required": ["formato"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "caso" } } },
      "then": { "required": ["empresa", "novedadBase", "porQueEncaja", "primerPaso", "esfuerzo", "impacto"] }
    }
  ]
}
